rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function me() { return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data; }
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function isAdmin()  { return isStaff() && me().role == 'admin'; }
    // admin and legacy 'staff' manage children; gate staff only tap; advisers only read their sections.
    function canManage() { return isStaff() && me().role in ['admin', 'staff']; }
    function canTap()    { return isStaff() && me().role in ['admin', 'staff', 'gate']; }
    // School head: can read children, taps and attendance for every section, but never change anything.
    function isHead()    { return isStaff() && me().role == 'head'; }
    // TV display account: can only read taps and photos for the hallway screen, never change anything.
    function isDisplay() { return isStaff() && me().role == 'display'; }
    function myAdvised(sec) {
      return isStaff() && me().role == 'adviser' && sec in me().get('sections', []);
    }
    // School-wide switch (admins set it in the Manage tab) that lets parents edit contact details.
    function parentEditOn() {
      return exists(/databases/$(database)/documents/settings/school)
        && get(/databases/$(database)/documents/settings/school).data.get('parentEdit', false) == true;
    }
    // School-wide switch that lets parents send change requests.
    function parentRequestsOn() {
      return exists(/databases/$(database)/documents/settings/school)
        && get(/databases/$(database)/documents/settings/school).data.get('parentRequests', false) == true;
    }
    function isParent(emails) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in emails;
    }

    // Staff list. Admins manage it from the app, including adding other admins.
    // Make the very first admin by hand: set role = "admin" on your own document in the console.
    match /staff/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() && request.resource.data.role in ['adviser', 'gate', 'head', 'admin', 'display'];
      // Admins can change a staff member's section assignment and personal details (never email or role).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sections', 'name', 'phone', 'gender'])
        && request.resource.data.get('sections', []) is list
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 120
        && request.resource.data.get('phone', '') is string && request.resource.data.get('phone', '').size() <= 30
        && request.resource.data.get('gender', '') in ['', 'M', 'F'];
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // Grades and sections. All staff can read; only admins add or remove.
    match /sections/{id} {
      allow read: if isStaff();
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    // Broadcast messages to all parents. Only admins send or delete; verified accounts (parents) and staff read.
    match /broadcasts/{id} {
      allow read: if isStaff() || (request.auth != null && request.auth.token.email_verified == true);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'body', 'time', 'by', 'byEmail', 'audience', 'tvUntil'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 1000
        && request.resource.data.time is number
        && request.resource.data.get('audience', 'both') in ['both', 'parents', 'tv']
        && request.resource.data.get('tvUntil', 0) is number
        && request.resource.data.by == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /kids/{id} {
      allow read: if canTap() || isHead() || isDisplay() || myAdvised(resource.data.get('section', '')) || isParent(resource.data.parentEmails);
      allow create, delete: if canManage();
      // Parents may change contact details only, and only while the school has the switch on.
      allow update: if canManage()
        || (isParent(resource.data.parentEmails)
            && parentEditOn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'altName', 'altPhone', 'contactUpdatedAt', 'contactUpdatedBy'])
            && request.resource.data.phone is string
            && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 30
            && request.resource.data.get('altName', '') is string && request.resource.data.get('altName', '').size() <= 60
            && request.resource.data.get('altPhone', '') is string && request.resource.data.get('altPhone', '').size() <= 30
            && request.resource.data.contactUpdatedAt is number
            && request.resource.data.contactUpdatedBy == request.auth.token.email);
    }

    // Requests from parents to change details they cannot edit themselves.
    match /changeRequests/{id} {
      allow read: if canManage()
        || (request.auth != null && request.auth.token.email_verified == true
            && resource.data.parentEmail == request.auth.token.email);
      allow create: if request.auth != null && request.auth.token.email_verified == true
        && parentRequestsOn()
        && request.resource.data.keys().hasOnly(['kidId', 'kidName', 'section', 'parentEmail', 'message', 'time', 'status'])
        && request.resource.data.parentEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.kidName is string && request.resource.data.kidName.size() <= 120
        && request.resource.data.section is string && request.resource.data.section.size() <= 80
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 500
        && request.resource.data.time is number
        && isParent(get(/databases/$(database)/documents/kids/$(request.resource.data.kidId)).data.parentEmails);
      allow update: if canManage()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'resolvedBy', 'resolvedTime'])
        && request.resource.data.status in ['done', 'declined']
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 300;
      allow delete: if false;
    }

    // A parent reports that their child is not at school even though an arrival was recorded.
    // Always on (not tied to the change-request switch). Staff who manage children read and close reports.
    match /childReports/{id} {
      allow read: if canManage()
        || (request.auth != null && request.auth.token.email_verified == true
            && resource.data.parentEmail == request.auth.token.email);
      allow create: if request.auth != null && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['kidId', 'kidName', 'section', 'parentEmail', 'tapTime', 'message', 'time', 'status'])
        && request.resource.data.parentEmail == request.auth.token.email
        && request.resource.data.status == 'open'
        && request.resource.data.kidName is string && request.resource.data.kidName.size() <= 120
        && request.resource.data.section is string && request.resource.data.section.size() <= 80
        && request.resource.data.tapTime is number
        && request.resource.data.message is string && request.resource.data.message.size() <= 300
        && request.resource.data.time is number
        && isParent(get(/databases/$(database)/documents/kids/$(request.resource.data.kidId)).data.parentEmails);
      allow update: if canManage()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'resolvedBy', 'resolvedTime'])
        && request.resource.data.status in ['at_school', 'not_at_school']
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 300;
      allow delete: if false;
    }

    // A parent tells the school ahead that the child will be absent today.
    // One per child per day (the id is kidId_day), never changed or deleted. Teachers read it and decide whether to excuse the absence.
    match /absenceNotes/{id} {
      allow read: if canManage() || isHead() || myAdvised(resource.data.get('section', ''))
        || (request.auth != null && request.auth.token.email_verified == true
            && resource.data.parentEmail == request.auth.token.email);
      allow create: if request.auth != null && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['kidId', 'kidName', 'section', 'parentEmail', 'day', 'reason', 'message', 'time'])
        && request.resource.data.parentEmail == request.auth.token.email
        && id == request.resource.data.kidId + '_' + request.resource.data.day
        && request.resource.data.day is string && request.resource.data.day.size() <= 12
        && request.resource.data.reason in ['sick', 'family', 'weather', 'other']
        && request.resource.data.kidName is string && request.resource.data.kidName.size() <= 120
        && request.resource.data.section is string && request.resource.data.section.size() <= 80
        && request.resource.data.message is string && request.resource.data.message.size() <= 300
        && request.resource.data.time is number
        && isParent(get(/databases/$(database)/documents/kids/$(request.resource.data.kidId)).data.parentEmails);
      allow update, delete: if false;
    }

    match /settings/{id} {
      allow read: if isStaff() || (request.auth != null && request.auth.token.email_verified == true);
      allow create, update: if isAdmin() && id == 'school'
        && request.resource.data.keys().hasOnly(['parentEdit', 'parentRequests', 'schoolName', 'schoolYear', 'schoolLogo', 'schoolId', 'schoolHead', 'lateAfter', 'lunchStart', 'lunchEnd', 'dismissTime', 'displayMode', 'displayLayout'])
        && request.resource.data.get('parentEdit', false) is bool
        && request.resource.data.get('parentRequests', false) is bool
        // School name, year, ID, head, late-after time and logo (a small image as a data URL) shown on every device.
        && request.resource.data.get('schoolName', '') is string && request.resource.data.get('schoolName', '').size() <= 120
        && request.resource.data.get('schoolYear', '') is string && request.resource.data.get('schoolYear', '').size() <= 20
        && request.resource.data.get('schoolId', '') is string && request.resource.data.get('schoolId', '').size() <= 30
        && request.resource.data.get('schoolHead', '') is string && request.resource.data.get('schoolHead', '').size() <= 120
        && request.resource.data.get('lateAfter', '') is string
        && (request.resource.data.get('lateAfter', '') == '' || request.resource.data.get('lateAfter', '').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && request.resource.data.get('lunchStart', '') is string
        && (request.resource.data.get('lunchStart', '') == '' || request.resource.data.get('lunchStart', '').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && request.resource.data.get('lunchEnd', '') is string
        && (request.resource.data.get('lunchEnd', '') == '' || request.resource.data.get('lunchEnd', '').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && request.resource.data.get('dismissTime', '') is string
        && (request.resource.data.get('dismissTime', '') == '' || request.resource.data.get('dismissTime', '').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && request.resource.data.get('displayMode', 'full') in ['full', 'first', 'initials']
        && request.resource.data.get('displayLayout', 'cards') in ['cards', 'list']
        && request.resource.data.get('schoolLogo', '') is string && request.resource.data.get('schoolLogo', '').size() <= 600000;
      // The two SF2 report logos, kept in their own document so the school record stays small.
      // An empty string means "use the default logo".
      allow create, update: if isAdmin() && id == 'sf2logos'
        && request.resource.data.keys().hasOnly(['left', 'right'])
        && request.resource.data.get('left', '') is string && request.resource.data.get('left', '').size() <= 400000
        && request.resource.data.get('right', '') is string && request.resource.data.get('right', '').size() <= 400000;
    }

    match /log/{id} {
      allow read: if canTap() || isHead() || isDisplay() || myAdvised(resource.data.get('section', '')) || isParent(resource.data.parentEmails);
      allow create: if canTap();
      allow update: if canManage()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentEmails', 'name', 'section']);
      allow delete: if false;
    }

    // Attendance edits. Admin/staff can edit any section; advisers only their own.
    // Never deleted, and the history list can only grow, so every change leaves a trace.
    match /adjustments/{id} {
      allow read: if canManage() || isHead() || myAdvised(resource.data.get('section', ''));
      allow create: if (canManage() || myAdvised(request.resource.data.get('section', '')))
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status in ['P', 'T', 'A', 'auto'];
      allow update: if (canManage()
          || (myAdvised(resource.data.get('section', '')) && myAdvised(request.resource.data.get('section', ''))))
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status in ['P', 'T', 'A', 'auto']
        && request.resource.data.kidId == resource.data.kidId
        && request.resource.data.month == resource.data.month
        && request.resource.data.day == resource.data.day
        && request.resource.data.history.size() > resource.data.history.size();
      allow delete: if false;
    }

    // "Child has not arrived" notices. Teachers (for their own sections) and admins create them; the push function reads them.
    // One per child per day (the id has the date), never changed or deleted.
    match /alerts/{id} {
      allow read: if canManage() || isHead() || myAdvised(resource.data.get('section', ''));
      allow create: if (canManage() || myAdvised(request.resource.data.get('section', '')))
        && request.resource.data.keys().hasOnly(['kidId', 'name', 'section', 'parentEmails', 'type', 'day', 'time', 'by'])
        && request.resource.data.type in ['absent', 'late']
        && request.resource.data.parentEmails is list && request.resource.data.parentEmails.size() <= 6
        && request.resource.data.time is number
        && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // Phone notification registrations from the parent app. Each parent only sees and changes their own.
    match /pushTokens/{token} {
      allow read, delete: if request.auth != null && resource.data.email == request.auth.token.email;
      allow create, update: if request.auth != null && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['email', 'prefs', 'time'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.prefs is map
        && request.resource.data.time is number
        && (resource == null || resource.data.email == request.auth.token.email);
    }

    // Visitors. Gate, staff and admin check visitors in and out; the head can read. The TV only reads (to show a count).
    // Never deleted; the only change allowed afterwards is the time out.
    match /visitors/{id} {
      allow read: if canTap() || isHead() || isDisplay();
      allow create: if canTap()
        && request.resource.data.keys().hasOnly(['name', 'phone', 'purpose', 'visiting', 'idShown', 'uid', 'photo', 'timeIn', 'timeOut', 'by'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.get('phone', '') is string && request.resource.data.get('phone', '').size() <= 30
        && request.resource.data.get('purpose', '') is string && request.resource.data.get('purpose', '').size() <= 80
        && request.resource.data.get('visiting', '') is string && request.resource.data.get('visiting', '').size() <= 120
        && request.resource.data.get('idShown', '') is string && request.resource.data.get('idShown', '').size() <= 40
        && request.resource.data.get('uid', '') is string && request.resource.data.get('uid', '').size() <= 80
        && request.resource.data.get('photo', '') is string && request.resource.data.get('photo', '').size() <= 150000
        && request.resource.data.timeIn is number
        && request.resource.data.timeOut == 0
        && request.resource.data.by == request.auth.uid;
      allow update: if canTap()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timeOut', 'timeOutBy'])
        && resource.data.timeOut == 0
        && request.resource.data.timeOut is number
        && request.resource.data.timeOut >= resource.data.timeIn
        && request.resource.data.timeOutBy == request.auth.uid;
      allow delete: if false;
    }
  }
}
